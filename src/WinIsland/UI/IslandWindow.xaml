<Window x:Class="WinIsland.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WinIsland.UI.Converters"
        xmlns:karaoke="clr-namespace:WinIsland.UI"
        Title="WinIsland"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="400" Height="400"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MenuGlass.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisInvert" Invert="True"/>

        <!-- Icon button (transparent, hover highlight) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{Binding ButtonHoverBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#22FFFFFF}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin progress slider -->
        <Style x:Key="ThinSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="Track" Height="4" CornerRadius="2"
                                    Background="{Binding SliderTrackBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#66FFFFFF}"/>
                            <Border x:Name="Fill" Height="4" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="PART_Thumb" Width="12" Height="12" Margin="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="thumb" Fill="{Binding SliderThumbBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                                         Stroke="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Thumb" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="PART_Thumb" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 逐句卡拉OK歌词：非当前句淡化，当前句大号醒目（20px） -->
        <Style x:Key="LyricLineText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="Opacity" Value="0.28"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Foreground" Value="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 歌词行容器：不加背景胶囊，当前句高亮只由卡拉OK文字渐变体现（避免双重高亮） -->
        <Style x:Key="LyricLineBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="{x:Null}">
        <!--
            仿 iOS 灵动岛：窗口固定 400x400，仅内部卡片形变。
            紧凑 = 340x56 胶囊；展开 = 400x~370 卡片，向下生长。
            透明区域点击穿透（WPF 按渲染内容命中测试）。
        -->
        <Border x:Name="Card" Width="360" Height="72" CornerRadius="28"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                ClipToBounds="True"
                Background="{Binding CardBackground, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#101018}"
                BorderBrush="{Binding CardBorder, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#33FFFFFF}"
                BorderThickness="1"
                ContextMenuOpening="Card_ContextMenuOpening">
            <Border.ContextMenu>
                <ContextMenu x:Name="IslandMenu">
                    <MenuItem x:Name="MenuCenterAlign" Header="居中对齐" Click="MenuCenterAlign_Click"/>
                    <MenuItem x:Name="MenuLock" Header="上锁" Click="MenuLock_Click"/>
                    <Separator/>
                    <MenuItem x:Name="MenuOnlineLyrics" Header="在线歌词（免配置）" IsCheckable="True" Click="MenuOnlineLyrics_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <Grid x:Name="ContentGrid" Margin="12,8,12,8" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ 胶囊行（始终可见）═══ -->
                <Grid x:Name="PillRow" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 按「组件顺序」动态渲染：歌曲信息 / 时间 / 天气（播放时含歌曲，空闲时去掉） -->
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding CompactItems}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>
                            <DataTemplate x:Key="TimeItem">
                                <TextBlock Text="{Binding DataContext.ClockText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           FontSize="{Binding DataContext.WidgetTimeFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
                            </DataTemplate>
                            <DataTemplate x:Key="WeatherItem">
                                <TextBlock Text="{Binding DataContext.WeatherText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,4,10,0"
                                           Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                            </DataTemplate>
                            <DataTemplate x:Key="SongItem">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,10,0"
                                            Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}">
                                        <Grid>
                                            <Image Source="{Binding Artwork, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill"
                                                   Visibility="{Binding Artwork, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVis}}"/>
                                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding Artwork, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisInvert}}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" Margin="0,1,0,0"
                                                   Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <karaoke:KaraokeTextBlock
                                            KaraokeText="{Binding CurrentLyricText, RelativeSource={RelativeSource AncestorType=Window}}"
                                            HighlightFraction="{Binding CompactHighlightFraction, RelativeSource={RelativeSource AncestorType=Window}}"
                                            IsPlaying="{Binding IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}"
                                            HighlightBrush="White" BaseBrush="#80FFFFFF"
                                            FontSize="12.5" Margin="0,2,0,0" TextAlignment="Left" FontWeight="SemiBold" Opacity="0.95"/>
                                        <ProgressBar Height="3" Maximum="1"
                                                     Value="{Binding Progress, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Margin="0,4,0,0">
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid>
                                                        <Border CornerRadius="2" Background="#33FFFFFF"/>
                                                        <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                                                Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Focusable="False" Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="ContentTemplate" Value="{StaticResource SongItem}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Time">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource TimeItem}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Weather">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource WeatherItem}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 按钮靠右 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource IconButton}" Command="{Binding PlayPauseCommand}">
                            <TextBlock Text="{Binding PlayPauseGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}">
                            <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>


                <!-- ═══ 展开内容 ═══ -->
                <StackPanel x:Name="ExpandedContent" Grid.Row="1" Margin="0,10,0,0"
                            Visibility="Collapsed" Opacity="0">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ExpandedScale" ScaleX="0.985" ScaleY="0.985"/>
                            <TranslateTransform x:Name="ExpandedTranslate" Y="8"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>

                    <!-- 大封面 + 标题/歌手/专辑 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BigArt" Width="72" Height="72" CornerRadius="18"
                                BorderBrush="{Binding AccentBorderBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#336C5CE7}"
                                BorderThickness="1"
                                Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#6C5CE7}">
                            <Grid>
                                <Image Source="{Binding Artwork}" Stretch="UniformToFill"
                                       Visibility="{Binding Artwork, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Artwork, Converter={StaticResource NullToVisInvert}}"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Artist}" FontSize="12.5" Margin="0,2,0,0"
                                       Foreground="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Album}" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <!-- 进度条 -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ProgressSlider" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1"
                                Value="{Binding Progress, Mode=OneWay}" IsEnabled="{Binding CanSeek}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PositionText}" FontSize="10"
                                       Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                            <TextBlock Text=" / " FontSize="10" Opacity="0.5"
                                       Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                            <TextBlock Text="{Binding DurationText}" FontSize="10"
                                       Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 控制行 -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}">
                                <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding PlayPauseCommand}">
                                <TextBlock Text="{Binding PlayPauseGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}">
                                <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                            </Button>
                        </StackPanel>
                        <!-- 音量 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding HasVolumeControl, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"/>
                            <Slider x:Name="VolumeSlider" Style="{StaticResource ThinSlider}" Width="90" Minimum="0" Maximum="1"
                                    Value="{Binding Volume, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 歌词（无边框，干净排版） -->
                    <ScrollViewer x:Name="LyricsScroll" Height="180" Margin="0,8,0,0"
                                  VerticalScrollBarVisibility="Hidden">
                        <ItemsControl x:Name="LyricsList" ItemsSource="{Binding LyricLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource LyricLineBorder}" HorizontalAlignment="Center">
                                        <karaoke:KaraokeTextBlock
                                            KaraokeText="{Binding Text}"
                                            HighlightFraction="{Binding HighlightFraction}"
                                            IsPlaying="{Binding DataContext.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}"
                                            HighlightBrush="{Binding TextPrimary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                            BaseBrush="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                                            Style="{StaticResource LyricLineText}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding LyricsStatus}" FontSize="12" HorizontalAlignment="Center" Margin="0,48,0,0" Opacity="0.65"
                               Foreground="{Binding TextSecondary, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=Gray}"
                               Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVisInvert}}"/>
                </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>







